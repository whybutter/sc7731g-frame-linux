# Merged over arch/arm/configs/multi_v7_defconfig (build.sh kernel).
#
# Bring-up stage: what has been seen working on the VT10101 is here, and each
# block gets added as its driver is proven. Every symbol is checked after the
# merge -- one that didn't stick fails the build instead of booting dark.

# The platform (ours: arch/arm/mach-sprd/Kconfig, added by the build) and its
# timer (timer-sprd-sc7731g.c, the vendor's 32 kHz blocks; mainline's sprd
# timer is the SC9860's and doesn't fit)
CONFIG_ARCH_SPRD=y
CONFIG_SC7731G_TIMER=y
CONFIG_MFD_SYSCON=y

# The uart1 driver (the GND/TX/RX pads). It was the console, with earlycon
# from stdout-path, until 2026-10-29; now the DT leaves uart1 to an
# ESP32-C3 BLE controller and the console is tty1, but debug boots still
# ask for console=ttyS1 (tools/uboot-cmd.py), so the console driver stays
CONFIG_SERIAL_SPRD=y
CONFIG_SERIAL_SPRD_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# 2 GiB on a 32-bit CPU
CONFIG_HIGHMEM=y

# Pixels before there is a display driver: the panel U-Boot left running,
# as a simple-framebuffer, through simpledrm (a DRM device cage can use)
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

# A busybox shell in an initramfs until there is storage
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# /dev/mem for poking the SoC from that shell (devmem) during bring-up
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# multi_v7's 8250 driver claims ttyS0-4 at boot, and sprd_serial's ttyS1 then
# fails to register ("cannot create duplicate filename /class/tty/ttyS1")
CONFIG_SERIAL_8250_RUNTIME_UARTS=0

# The ADI bus to the SC2713S PMIC (kernel/patches/0001: mainline knows only
# the SC9860's controller): register access, and reboot through the PMIC's
# watchdog the way the vendor kernel does. HWSPINLOCK only because the
# driver depends on it; the dts gives it no lock.
CONFIG_SPI=y
CONFIG_HWSPINLOCK=y
CONFIG_SPI_SPRD_ADI=y

# Cores 1-3 through the boot ROM's holding pen (kernel/mach-sprd/platsmp.c);
# multi_v7 already has SMP, this only pins it
CONFIG_SMP=y

# The eMMC (kernel/sdhci-sprd-sc7731g.c), built in: the root filesystem
# will live there
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_SC7731G=y
CONFIG_EXT4_FS=y
CONFIG_EFI_PARTITION=y

# DISPC as a KMS device that can import buffers (lima renders through it);
# takes over from simpledrm at probe (kernel/sprd-sc7731g-dispc.c). CMA
# backs the GEM DMA buffers.
CONFIG_DRM_SC7731G_DISPC=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y

# The Mali-400 MP2 (lima): the reason this frame runs mainline at all
CONFIG_DRM_LIMA=y

# Touch: GPIO (mainline gpio-sprd fits), our I2C controller driver, and the
# silead driver for the gslX680 with its firmware in the initramfs
CONFIG_GPIO_SPRD=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_SC7731G=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SILEAD=y

# Backlight: PWM3 (kernel/pwm-sprd-sc7731g.c) into pwm-backlight, the
# /sys/class/backlight the frame shell drives
CONFIG_PWM=y
CONFIG_PWM_SC7731G=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# The presence radar ("zed-radar", GPIO 217) is read by frame-shell through
# /sys/class/gpio like the A33's PIR; on mainline the line is <chip base>+217
CONFIG_GPIO_SYSFS=y

# USB: dwc2 as a gadget (role switch pinned to peripheral), the PHY glue
# (kernel/phy-sprd-sc7731g-usb.c), and a CDC ECM network function built in
# so usb0 exists without configfs
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_SC7731G_USB=y
CONFIG_USB_ETH=y
# CONFIG_USB_ETH_RNDIS is not set
CONFIG_INET=y
# A hung frame needs somebody at the plug. These turn the hangs the kernel
# can still see (a CPU stuck with interrupts on, a task stuck in D, an RCU
# stall -- the last via sysctl.kernel.panic_on_rcu_stall=1 on the command
# line) into panics, and panic=5 into a restart through the PMIC. A hang
# that takes every core is pmic-wdt's (initramfs/pmic-wdt, `wdt`).
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
# the PMIC LDOs (touch vdd28, USB vddusb)
CONFIG_REGULATOR_SC2713S=y
CONFIG_WCN_SC7731G=y
CONFIG_SPRDWL_SC7731G=y
# The frame userland's needs, found missing when its rootfs first booted on
# this kernel (2026-10-27, frameboot): nf_tables for a firewall, cgroups and
# namespaces for an app sandbox, uinput for a touch daemon, ext4 ACLs, zstd
# firmware, TUN for a VPN client.
# Built in rather than =m: this kernel has no modules. The userland's modprobe
# calls were thought to fail harmlessly; they didn't -- a failing modprobe
# uinput kept the touch daemon from starting, and each one printed on the
# glass (2026-10-27). frameboot now gives the root this kernel's
# modules.builtin, so a modprobe of anything below succeeds. From the A33
# frame's kernel config, minus the A33's own hardware (rtw88, its BT UART,
# the DA280 accelerometer) and the hard-lockup detector (no NMI on ARM32
# here).
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_SOCKET=y
CONFIG_NF_CONNTRACK=y
CONFIG_INPUT_UINPUT=y
CONFIG_TUN=y
# the DA213 accelerometer on i2c2, under mainline's da280 driver (the dts)
CONFIG_IIO=y
CONFIG_DA280=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# /dev/watchdog on the SC2713S PMIC watchdog (regulator-sc2713s.c), for
# a userland watchdog feeder
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
# Wi-Fi through our USB dongle on the micro-USB port, dwc2 in host
# mode (docs/wifi.md): a TP-Link TL-WN821N that is really an RTL8192CU
# (0bda:8178, which rtl8xxxu lists only under UNTESTED -- "still supported
# by rtlwifi", whose rtl8192cu claims the same id and stays out). Its
# firmware (rtlwifi/rtl8192cufw*.bin) is in the rootfs: the role
# switch to host, and with it the driver's probe, comes after switch_root.
# VBUS is the OTG boost on GPIO 69, a fixed regulator in the dts. Spare
# drivers for other dongles are in kernel/wifi.config (WIFI=1 test builds)
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# Sound (docs/audio.md): the AP DMA (mainline sprd-dma, patch 0003), the VBC
# and SC2713S codec (sound/soc/sprd/, copied in by build/kernel.sh) under
# mainline's sprd-pcm-dma, and a simple-audio-card from the DT
CONFIG_DMADEVICES=y
CONFIG_SPRD_DMA=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SPRD=y
CONFIG_SND_SIMPLE_CARD=y
# Bluetooth (2026-10-29): the built-in WCN controller is BR/EDR 2.1 only
# (no LE commands at all), reached from user space -- a daemon
# bridges its HCI ring (SIPC sbuf ch 4) to /dev/vhci, so hci_vhci gives
# BlueZ an hci0 with no kernel SIPC driver. btusb too, for a USB BLE dongle
# should BLE need one.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIVHCI=y
CONFIG_BT_HCIBTUSB=y
# (2026-10-30) the kernel's WCN driver owns cp2 now, so the vhci bridge
# stands down; its HCI ring is an hci device of the kernel's own instead,
# next to the Wi-Fi on the same cp2 (bt-sc7731g). vhci stays for tests
CONFIG_BT_SC7731G=y
# an ESP32-C3 on uart1 as an H4 BLE controller (docs/ble-c3.md), attached
# with btattach: the WCN's controller has no LE
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
# the last kernel log across a crash (ramoops in the DT's reserved-memory)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
