		};

		clk_ccir_in: clk-ccir-in {
			compatible = "sprd,sc7731g-fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x3d09000>;
			clock-output-names = "clk_ccir_in";
		};

		clk_mm: clk-mm {
			compatible = "sprd,sc7731g-gate-clock";
			#clock-cells = <0x00>;
			reg = <0x402e0000 0x2000000 0x402b001d 0x2000000>;
			clocks = <&clk_aon_apb>;
			clock-output-names = "clk_mm";
		};

		/* by hand: the vendor's node plus sprd,domain (the GPU power
		 * domain and bus gate, what clk_gpu_axi's prepare/enable do), so
		 * its in-GPU mux can be read; parents are the gated PLL taps */
		clk_gpu: clk-gpu {
			compatible = "sprd,sc7731g-composite-dev-clock";
			#clock-cells = <0x00>;
			reg = <0x60100004 0x07 0x60100004 0x30>;
			sprd,domain = <0x402b0021 0x2000000 0x402e0000 0x8000000>;
			clocks = <&clk_153m6_gpu_gate &clk_208m_gpu_gate
				  &clk_256m_gpu_gate &clk_300m_gpu_gate
				  &clk_312m_gpu_gate &clk_384m_gpu_gate
				  &clk_460m8_gpu_gate>;
			clock-output-names = "clk_gpu";
		};
