# c3-hci: the ESP32-C3 Super Mini as the VT10101's BLE controller, HCI H4 over
# UART1 to the frame's ttyS1 (docs/ble-c3.md). From ESP-IDF's
# controller_hci_uart_esp32c3_and_esp32s3 example, with these changes:
CONFIG_IDF_TARGET="esp32c3"
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_CTRL_HCI_MODE_UART_H4=y
CONFIG_BT_CTRL_HCI_TL=0
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_SUPP=n
CONFIG_BT_CTRL_BLE_SCAN_DUPL=n
# 1 Mbaud is exact on both ends: 26 MHz / 26 on the SC7731G, 80 MHz / 80 here
CONFIG_C3HCI_UART_BAUDRATE=1000000
# every log -- ROM, bootloader, app -- on USB-Serial-JTAG, never a UART pin:
# the frame's U-Boot stops autoboot on any byte that reaches ttyS1 RX
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
