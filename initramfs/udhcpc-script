#!/bin/sh
# udhcpc's event script for wifitest: busybox's udhcpc only hands over the
# lease (and Alpine's busybox-static ships no default.script), this applies
# it -- address, default route, resolv.conf
case "$1" in
  deconfig) ip -4 addr flush dev "$interface"; ip link set "$interface" up ;;
  bound|renew)
    ip -4 addr flush dev "$interface"
    ip -4 addr add "$ip/${mask:-24}" dev "$interface"
    for r in $router; do ip route replace default via "$r" dev "$interface"; break; done
    mkdir -p /etc
    : > /etc/resolv.conf
    for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
    echo "udhcpc: $interface $ip/${mask:-24} via ${router:-none}" ;;
esac
