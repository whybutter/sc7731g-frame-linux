#!/bin/sh
# Bring-up probe: what the next drivers need to know, read off the running
# SoC in one boot. Every line starts with "probe:" so it can be grepped out of
# the UART log (tools/uboot-boot.py). Only blocks U-Boot leaves clocked are
# read: a read from a gated block can hang the bus, and with it the console.

# a PMIC (SC2713S) register over the ADI's old-style read: its physical
# address into RD_CMD (0x40030024), the value in RD_DATA's low 16 bits once
# bit 31 (busy) drops
adi() {
  devmem 0x40030024 32 "$2"
  v=$(devmem 0x40030028 32); v=$(devmem 0x40030028 32)
  printf 'probe: %-22s %s = %s\n' "adi_$1" "$2" "$v"
}
r() { printf 'probe: %-22s %s = %s\n' "$1" "$2" "$(devmem "$2" 32 2>&1)"; }

echo "probe: kernel $(uname -r), cmdline: $(cat /proc/cmdline)"
echo "probe: cpus online $(cat /sys/devices/system/cpu/online)"

# SMP: the power domains of cores 1-3 and their state
r pd_ca7_c1_cfg 0x402b0008
r pd_ca7_c2_cfg 0x402b000c
r pd_ca7_c3_cfg 0x402b0010
r pwr_status0_dbg 0x402b00bc
r ca7_rst_set 0x20d00008
r holding_pen 0x20d00014
# the AP's sleep controls (the first SMP boot hung with all cores idle):
# MCU_PAUSE bits 0-3 (platsmp.c clears them and logs what it found),
# AP_SYS_AUTO_SLEEP_CFG, AP_SYS_FORCE_SLEEP_CFG, and the CA7 top / core 0
# power domains' auto-shutdown arming
r mcu_pause 0x20d03004
r ap_sys_auto_sleep 0x20d00010
r ap_sys_force_sleep 0x20d0000c
r pd_ca7_top_cfg 0x402b0000
r pd_ca7_c0_cfg 0x402b0004

# Clocks U-Boot set up: AP_AHB gates, the eMMC/SD/SDIO muxes (vendor DT
# clk_emmc and friends: reg 0x712000xx mask 3), the display's
r ap_ahb_eb 0x20d00000
r clk_sdio0 0x71200048
r clk_sdio1 0x7120004c
r clk_sdio2 0x71200050
r clk_emmc 0x71200054
r clk_dispc0 0x7120002c
r clk_dispc0_dbi 0x71200030
r clk_dispc0_dpi 0x71200034

# PLLs (CFG1: 26 MHz * (Nint[5:0] + Kint[31:12]/2^20 if bit 6)), and the
# GPU's power domain and bus gate, for lima
for a in 0x402e3070 0x402e3074 0x402e3078 0x402e301c 0x402e307c 0x402e3080; do
  r pll_cfg1 $a
done
r pd_gpu_top_cfg 0x402b0020
r aon_apb_eb0 0x402e0000
r aon_apb_eb1 0x402e0004

# The backlight's PWM3 as U-Boot left it (PRESCALE, CNT, PAT_LOW, PAT_HIG)
for o in 0x60 0x64 0x6c 0x70; do
  r pwm3_$o $(printf 0x%x $((0x40260000 + o)))
done

# PMIC power switches (ANA_APB_IF at 0x40038800): LDO/DCDC power-down
# latches (+0x10 set, +0x14 clear), LDO_PD_CTRL (+0x1c: bit 9 = USB LDO off,
# for USB gadget), LDO voltages (+0x20..+0x28); vdd28 feeds the touch
adi ldo_dcdc_pd_rtcset 0x40038810
adi ldo_dcdc_pd_rtcclr 0x40038814
adi ldo_pd_ctrl 0x4003881c
adi ldo_v_ctrl0 0x40038820
adi ldo_v_ctrl1 0x40038824
adi ldo_v_ctrl2 0x40038828
# the watchdog the restart handler and pmic-wdt use: if these offsets are
# right, CTRL shows RUN|RST|NEW (0xe) while `wdt` is on and CNT moves
adi wdg_ctrl 0x40038048
adi wdg_cnt_low 0x40038058
adi wdg_cnt_low 0x40038058
adi glb_arm_module_en 0x40038800
adi glb_rtc_clk_en 0x40038808
adi glb_por_rst_monitor 0x400388e8

# USB: PHY power (AON_APB PWR_CTRL bit 0 = PHY off), AHB gate (AP_AHB EB
# bit 4), PHY tune (AP_APB +0x3000; the vendor DT's tune_value 0x44073e33)
r aon_pwr_ctrl 0x402e0024
r ap_ahb_rst 0x20d00004
r usb_phy_tune 0x71303000

# The eMMC host: does it report capabilities the sdhci core can trust?
for o in 0x24 0x28 0x2c 0x3c 0x40 0x44 0x48 0x80 0x84 0x88 0xfc; do
  r sdhci_emmc_$o $(printf 0x%x $((0x20600000 + o)))
done

# DISPC and the DSI host as U-Boot left them lit, for the display driver
o=0; while [ $o -lt 512 ]; do
  r dispc_$(printf %03x $o) $(printf 0x%x $((0x20800000 + o))); o=$((o + 4))
done
o=0; while [ $o -lt 256 ]; do
  r dsi_$(printf %03x $o) $(printf 0x%x $((0x21800000 + o))); o=$((o + 4))
done

# Touch: out-4 had vdd28 on and the gslX680 still NACKed at i2c1 0x40, while
# Android has it bound there. Raise its reset/power line (GPIO 81; the
# silead driver released it when its probe failed), then ask the chip, and
# ask i2c2's accelerometer (0x26 under Android) as a control for our I2C
# driver. Then scan both buses for whatever answers.
base=$(for c in /sys/class/gpio/gpiochip*; do
  [ "$(cat $c/label 2>/dev/null)" = 40280000.gpio ] && cat $c/base; done)
echo "probe: gpio chip base ${base:-none}"
if [ -n "$base" ]; then
  echo $((base + 81)) > /sys/class/gpio/export 2>/dev/null
  echo out > /sys/class/gpio/gpio$((base + 81))/direction 2>/dev/null
  echo 0 > /sys/class/gpio/gpio$((base + 81))/value 2>/dev/null; sleep 1
  echo 1 > /sys/class/gpio/gpio$((base + 81))/value 2>/dev/null; sleep 1
  echo "probe: gpio81 = $(cat /sys/class/gpio/gpio$((base + 81))/value 2>&1)"
  r gpio_bank5_data 0x40280280
  r gpio_bank5_dmsk 0x40280284
  r gpio_bank5_dir 0x40280288
fi
r i2c1_ctl 0x70600000
r i2c1_clkd0 0x70600008
r i2c1_clkd1 0x7060000c
r pin_scl1 0x402a0130
r pin_sda1 0x402a0134
echo "probe: i2c1 0x40 scan: $(i2cxfer 1 0x40 scan 2>&1)"
echo "probe: i2c1 0x40 id (0xfc): $(i2cxfer 1 0x40 0xfc 4 2>&1)"
echo "probe: i2c1 0x40 0xf0: $(i2cxfer 1 0x40 0xf0 1 2>&1)"
echo "probe: i2c2 0x26 scan: $(i2cxfer 2 0x26 scan 2>&1)"
for b in 1 2; do
  found=""; a=8
  while [ $a -lt 120 ]; do
    i2cxfer $b $a scan >/dev/null 2>&1 && found="$found $(printf %02x $a)"
    a=$((a + 1))
  done
  echo "probe: i2c$b answers:${found:- none}"
done

if mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null &&
   [ -r /sys/kernel/debug/clk/clk_summary ]; then
  echo "probe: --- clock tree"
  sed 's/^/probe: /' /sys/kernel/debug/clk/clk_summary
fi
echo "probe: --- interrupts"
sed 's/^/probe: /' /proc/interrupts

echo "probe: --- kernel messages of interest"
dmesg | grep -iE 'smp|cpu[0-9]|mmc|sdhci|adi|simpledrm|restart|error|fail' | sed 's/^/probe: /'
[ -e /proc/partitions ] && sed 's/^/probe: /' /proc/partitions
echo "probe: done"
